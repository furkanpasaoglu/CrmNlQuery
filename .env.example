# Copy to .env (git-ignored) and fill in. Never commit .env.
# Required: a long random password for the bundled PostgreSQL.
POSTGRES_PASSWORD=
# Leave CRM_PASSWORD empty to configure the CRM, the model and the administrator in the first-run setup wizard (open /setup).
# Fill it in only if you want to configure the service entirely from this file.
CRM_PASSWORD=
# Optional overrides (defaults shown)
# CRM_BASE_URL=http://crm.example.com/contoso   (lab only: use an https URL in production so Windows credentials never travel unencrypted)
# CRM_DOMAIN=CONTOSO
# CRM_USERNAME=Administrator   (lab only: use a least-privilege CRM service account such as svc-nlquery in production)
# DEV_USER=CONTOSO\Administrator
# POSTGRES_PORT=5433
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.6:27b
# vLLM (profile "vllm"; needs an NVIDIA GPU; the model downloads from Hugging Face on first start):
# LLM_PROVIDER=Vllm
# VLLM_MODEL=Qwen/Qwen3-4B-AWQ
# VLLM_API_KEY=change-me
# VLLM_MAX_MODEL_LEN=16384
# To use the Claude API in the lab instead of Ollama (lab data only):
# LLM_PROVIDER=Anthropic
# LLM_ALLOW_CLOUD=true
# ANTHROPIC_API_KEY=
# Sign-in: Fixed = one development user; CrmProof = users prove who they are through the CRM (needs AUTH_SIGNING_KEY, at least 32 random characters)
# IDENTITY_MODE=CrmProof
# AUTH_SIGNING_KEY=
# Who can reach the service: 127.0.0.1 = this computer only (default); 0.0.0.0 = the network (needed when CRM users open the chat from their own computers; put it behind TLS and a firewall rule)
# BIND_ADDRESS=0.0.0.0
