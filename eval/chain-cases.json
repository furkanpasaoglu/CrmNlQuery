[
  {
    "id": "A-firsat-tarih-firma-sehir",
    "note": "Fırsatlar (>50k) -> kapanış tarihi daralt -> firmalara geç -> şehir daralt. Lab: renewal 9,1,3,4,10,5; sonra 3 ve 10; firmalar Brightwave (London) ve Sakura (Osaka).",
    "turns": [
      {
        "id": "A1",
        "question": "Tahmini geliri 50 binin üstündeki fırsatları getir",
        "answers": {
          "columns": "default"
        },
        "expect": {"finalKind": "answer", "entity": "opportunity", "reference": {"fetchXml": "<fetch><entity name='opportunity'><attribute name='name'/><filter><condition attribute='estimatedvalue' operator='gt' value='50000'/></filter></entity></fetch>"}}
      },
      {
        "id": "A2",
        "question": "Bunlardan kapanış tarihi 2026-12-01'den önce olanlar",
        "expect": {"finalKind": "answer", "entity": "opportunity", "followUp": true,"reference": {"fetchXml": "<fetch><entity name='opportunity'><attribute name='name'/><filter><condition attribute='estimatedvalue' operator='gt' value='50000'/><condition attribute='estimatedclosedate' operator='lt' value='2026-12-01'/></filter></entity></fetch>"}}
      },
      {
        "id": "A3",
        "question": "Bu fırsatların firmalarını getir",
        "answers": {
          "columns": "default"
        },
        "expect": {"finalKind": "answer", "entity": "account", "followUp": true,"reference": {"fetchXml": "<fetch distinct='true'><entity name='account'><attribute name='name'/><link-entity name='opportunity' from='customerid' to='accountid' link-type='inner' alias='lo'><filter><condition attribute='estimatedvalue' operator='gt' value='50000'/><condition attribute='estimatedclosedate' operator='lt' value='2026-12-01'/></filter></link-entity></entity></fetch>"}}
      },
      {
        "id": "A4",
        "question": "Bunlardan London'dakiler",
        "expect": {"finalKind": "answer", "entity": "account", "followUp": true,"reference": {"fetchXml": "<fetch distinct='true'><entity name='account'><attribute name='name'/><filter><condition attribute='address1_city' operator='eq' value='London'/></filter><link-entity name='opportunity' from='customerid' to='accountid' link-type='inner' alias='lo'><filter><condition attribute='estimatedvalue' operator='gt' value='50000'/><condition attribute='estimatedclosedate' operator='lt' value='2026-12-01'/></filter></link-entity></entity></fetch>"}}
      }
    ]
  },
